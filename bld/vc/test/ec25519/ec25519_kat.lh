;
; EC25519 known-answer tests (KAT) driven from LH.
;
; ed25519 vectors: RFC 8032 section 7.1 (TEST 1, 2, 3), hex RFC 8032.
; x25519 vectors:  RFC 7748 section 6.1 (Curve25519 Diffie-Hellman).
;
; Run with the interpreter binary built by vccmd/build.sh:
;   vccmd -c <this dir> ec25519_kat.lh
;
; Every FAILED print indicates a mismatch.
; A clean run prints EC25519-KAT-COMPLETE with no FAILED lines.
;

; printl/nl normally come from lhlib/common.lh loaded via $HOME/lhlib/load.lh
; by the interpreter; define them locally so the tests are self-contained
gcompile(nl `print(|\n|)')
gcompile(printl x `print(<x>) nl()')

; records/prints a failure when <b> is nil
gcompile(expect name b `if(<b> nil prog(printl(name) printl(FAILED)))')

; --- ed25519 RFC 8032 TEST 1: empty message ---
lbind(empty substr(abc 0 0))
expect(ed-kat-1-empty-len eq(strlen(<empty>) 0))
lbind(ed1_sec from-hex(9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60))
lbind(ed1_pub from-hex(d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a))
lbind(ed1_sig from-hex(e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b))
expect(ed-kat-1-pub eq(ED25519-pub-from-priv(<ed1_sec>) <ed1_pub>))
expect(ed-kat-1-sig eq(ED25519-sign-key(<empty> <ed1_sec>) <ed1_sig>))
expect(ed-kat-1-verify ED25519-verify-key(<empty> <ed1_sig> <ed1_pub>))

; --- ed25519 RFC 8032 TEST 2: 1-byte message 0x72 ---
; "72" must be forced to a string token (72 is parsed as a number)
lbind(ed2_msg from-hex(substr(72x 0 2)))
lbind(ed2_sec from-hex(4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb))
lbind(ed2_pub from-hex(3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c))
lbind(ed2_sig from-hex(92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00))
expect(ed-kat-2-pub eq(ED25519-pub-from-priv(<ed2_sec>) <ed2_pub>))
expect(ed-kat-2-sig eq(ED25519-sign-key(<ed2_msg> <ed2_sec>) <ed2_sig>))
expect(ed-kat-2-verify ED25519-verify-key(<ed2_msg> <ed2_sig> <ed2_pub>))

; --- ed25519 RFC 8032 TEST 3: 2-byte message 0xaf82 ---
lbind(ed3_sec from-hex(c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7))
lbind(ed3_pub from-hex(fc51cd8e6218a1a38da47ed00230f0580816ed13ba3303ac5deb911548908025))
lbind(ed3_sig from-hex(6291d657deec24024827e69c3abe01a30ce548a284743a445e3680d7db5ac3ac18ff9b538d16f290ae67f760984dc6594a7c15e9716ed28dc027beceea1ec40a))
expect(ed-kat-3-pub eq(ED25519-pub-from-priv(<ed3_sec>) <ed3_pub>))
expect(ed-kat-3-sig eq(ED25519-sign-key(from-hex(af82) <ed3_sec>) <ed3_sig>))
expect(ed-kat-3-verify ED25519-verify-key(from-hex(af82) <ed3_sig> <ed3_pub>))

; --- x25519 RFC 7748 6.1 Diffie-Hellman ---
lbind(apriv from-hex(77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a))
lbind(apub from-hex(8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a))
lbind(bpriv from-hex(5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb))
lbind(bpub from-hex(de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f))
lbind(shared from-hex(4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742))
expect(x-kat-1-apub eq(X25519-pub-from-priv(<apriv>) <apub>))
expect(x-kat-1-bpub eq(X25519-pub-from-priv(<bpriv>) <bpub>))
expect(x-kat-1-shared-a eq(X25519-agree-key(<apriv> <bpub>) <shared>))
expect(x-kat-1-shared-b eq(X25519-agree-key(<bpriv> <apub>) <shared>))

; low-order point tests (agree with zero/loworder inputs) are covered by
; ec25519_cpp_test.cpp which can handle both success and failure outcomes.

printl(EC25519-KAT-COMPLETE)