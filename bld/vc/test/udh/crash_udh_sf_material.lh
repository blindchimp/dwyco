;
; crash: UDH-sf-material before UDH-init must crash, not return a bogus value
;
gcompile(nl `print(|\n|)')
gcompile(printl x `print(<x>) nl()')
; dereferences the null EphDH at vcudh.cpp:246. The second arg MUST be a
; string, otherwise the existing guard at vcudh.cpp:362 fires first and
; (correctly) raises a catchable USER_BOMB instead of crashing.
lbind(s vector(0123456789abcdef fedcba9876543210))
UDH-sf-material(<s> somekeyname)
printl(THIS-SHOULD-NEVER-PRINT)
